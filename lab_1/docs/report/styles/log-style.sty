% Стиль отчёта. Адаптация стиля шаблона OS_report_template под
% лабораторную работу №1 (C++20, динамический массив).
%
% ВАЖНО: собирается XeLaTeTeX, не pdflatex:
%     xelatex report.tex
%     xelatex report.tex
% Причина: в исходниках main.cpp есть кириллица в строковых литералах.
% listingsutf8 (пакет для pdflatex) несовместим с listings 1.11 и валит
% сборку на "Invalid UTF-8 byte sequence". Под XeLaTeTeX UTF-8 нативный,
% поэтому listings обрабатывает кириллицу без посторонних пакетов.

\usepackage{geometry}
\geometry{
  left=30mm,
  right=15mm,
  top=20mm,
  bottom=20mm
}

% Шрифты с кириллицей. Под XeLaTeTeX кодировки не задаются:
% inputenc/fontenc не нужны и только мешают.
\usepackage{fontspec}
\setmainfont{Times New Roman}
\setsansfont{Arial}
\setmonofont{Consolas}[Scale=0.92]

